<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FocusLedger</AssemblyName>
    <Version>0.3.10</Version>
    <ApplicationIcon>Assets/focusledger.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF owns window DPI through the manifest; WinForms is only used for the tray. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup><Using Remove="System.Windows.Forms" /><Using Remove="System.Drawing" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/focusledger.ico" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/focusledger.png" /></ItemGroup>
  <ItemGroup>
    <None Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../NOTICE" Link="NOTICE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../licenses/*.txt" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../FocusLedger.Storage/FocusLedger.Storage.csproj" /></ItemGroup>
</Project>
