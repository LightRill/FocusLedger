<UserControl x:Class="FocusLedger.App.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="{DynamicResource AppFont}" FontSize="13" Foreground="{DynamicResource Ink}">
 <Grid Margin="30">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="按你的习惯，记录时间" Style="{StaticResource PageTitle}"/><TextBlock Text="调整空闲判断，选择软件，并把数据保存在你指定的位置。" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/></StackPanel>
  <TabControl x:Name="SettingsTabs" Grid.Row="1" Background="Transparent" BorderBrush="{DynamicResource Line}" Margin="0,0,0,18">
   <TabItem Header="计时与软件" Padding="18,9">
    <Grid Margin="18">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,18">
      <TextBlock Text="默认空闲阈值" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <StackPanel Orientation="Horizontal"><TextBox x:Name="DefaultIdleInput" Width="66" Text="3"/><TextBlock Text="分钟" Margin="10,0,18,0" VerticalAlignment="Center"/><Button Content="应用到全部软件" Click="ApplyAll_Click" Margin="0"/></StackPanel>
      <TextBlock Text="可设置 1–60 分钟。新增软件沿用此默认值，也可双击下表单独修改。" Foreground="{DynamicResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
      <TextBlock Text="阈值内继续计时；超时暂停，已计入的时间保留。" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
     </StackPanel>
     <DataGrid x:Name="RulesGrid" Grid.Row="1" CanUserDeleteRows="False" IsReadOnly="False" SelectionMode="Single" Margin="0,0,0,16">
      <DataGrid.Columns>
       <DataGridCheckBoxColumn ElementStyle="{StaticResource TableCheck}" EditingElementStyle="{StaticResource TableCheckEditor}" HeaderStyle="{StaticResource CenteredTableHeader}" Header="启用" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
       <DataGridTextColumn ElementStyle="{StaticResource TableText}" EditingElementStyle="{StaticResource TableEditor}" Header="显示名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="1.1*"/>
       <DataGridTextColumn ElementStyle="{StaticResource TableText}" EditingElementStyle="{StaticResource TableEditor}" Header="进程名（不含路径）" Binding="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}" Width="1.6*"/>
       <DataGridTextColumn ElementStyle="{StaticResource TableNumber}" EditingElementStyle="{StaticResource TableNumberEditor}" HeaderStyle="{StaticResource CenteredTableHeader}" Header="空闲阈值（分钟）" Binding="{Binding IdleMinutes, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="145"/>
      </DataGrid.Columns>
     </DataGrid>
     <WrapPanel Grid.Row="2"><Button Content="添加 .exe" Click="AddExecutable_Click" Margin="0,0,8,8"/>
      <Grid Width="220" Margin="0,0,8,8"><ComboBox x:Name="Processes" IsEditable="False" AutomationProperties.Name="选择运行中的软件"/>
       <TextBlock Text="请选择运行中的软件" Margin="10,0,28,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=Processes}" Value="-1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid>
      <Button Content="添加运行中软件" Click="AddProcess_Click" Margin="0,0,8,8"/><Button Content="刷新列表" Click="RefreshProcesses_Click" Margin="0,0,8,8"/><Button Content="移除选中" Click="Remove_Click" Margin="0,0,0,8"/></WrapPanel>
    </Grid>
   </TabItem>
   <TabItem Header="数据与启动" Padding="18,9">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22">
     <TextBlock Text="数据保存位置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <TextBox x:Name="DataDirectoryInput" TextWrapping="Wrap" MinHeight="40" Margin="0,0,0,12"/>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><Button Content="选择文件夹…" Click="ChooseDirectory_Click"/><Button Content="使用默认位置" Click="DefaultDirectory_Click"/></StackPanel>
     <TextBlock x:Name="DefaultPathText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"/>
     <Border Background="{DynamicResource Soft}" CornerRadius="8" Padding="15" Margin="0,0,0,24"><TextBlock Text="保存后自动将现有记录与设置复制到新目录，并立即使用新位置。原目录保留为副本。目标目录已有记录时，会先询问是否切换，不会直接覆盖。" TextWrapping="Wrap" LineHeight="23"/></Border>
     <TextBlock Text="启动与隐私" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>
     <CheckBox x:Name="StartupCheck" Content="登录 Windows 后自动启动，并隐藏到托盘" Margin="0,0,0,18"/>
     <TextBlock Text="读取进程名与输入空闲时间，不保存输入内容、窗口标题或截图。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="外观主题" Padding="18,9">
    <StackPanel Margin="24">
     <TextBlock Text="给专注选一种颜色" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <TextBlock Text="保存后应用到所有页面与托盘菜单，下次启动沿用。" Foreground="{DynamicResource Muted}" Margin="0,0,0,26"/>
     <ComboBox x:Name="ThemeChoice" Width="280" HorizontalAlignment="Left" SelectedIndex="0">
      <ComboBoxItem Content="森野 · 温润绿" Tag="Forest"/>
      <ComboBoxItem Content="晴空 · 清透蓝" Tag="Ocean"/>
      <ComboBoxItem Content="夜航 · 深色" Tag="Dark"/>
     </ComboBox>
     <WrapPanel Margin="0,26,0,24">
      <Border Background="#32745E" Width="125" Height="88" CornerRadius="14" Margin="0,0,16,0"><TextBlock Text="森野" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="17"/></Border>
      <Border Background="#3569B1" Width="125" Height="88" CornerRadius="14" Margin="0,0,16,0"><TextBlock Text="晴空" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="17"/></Border>
      <Border Background="#1D2735" Width="125" Height="88" CornerRadius="14"><TextBlock Text="夜航" Foreground="#E7EDF5" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="17"/></Border>
     </WrapPanel>
     <TextBlock Text="使用微软雅黑 UI 字体，中文、数字和表格保持清晰。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
    </StackPanel>
   </TabItem>
  </TabControl>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="取消" Click="Cancel_Click"/><Button Content="保存设置" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="0"/></StackPanel></Grid>
 </Grid>
</UserControl>
