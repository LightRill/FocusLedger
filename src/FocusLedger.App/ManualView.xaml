<UserControl x:Class="FocusLedger.App.ManualView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="{DynamicResource AppFont}" FontSize="13" Foreground="{DynamicResource Ink}">
 <StackPanel Margin="30">
  <TextBlock x:Name="Heading" Text="补记一段投入" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,10"/>
  <TextBlock Text="重叠区间将被替换，总时长不会重复累计。" Foreground="{DynamicResource Muted}" Margin="0,0,0,22"/>
  <TextBlock Text="软件名称" Margin="0,0,0,6"/><ComboBox x:Name="AppName" IsEditable="True" Margin="0,0,0,16"/>
  <TextBlock x:Name="TimeZoneLabel" Text="开始时间（本地时间）" Margin="0,0,0,6"/><TextBox x:Name="StartTime" Margin="0,0,0,14"/>
  <TextBlock Text="结束时间 · 格式：2026-10-14 15:30:00" Margin="0,0,0,6"/><TextBox x:Name="EndTime" Margin="0,0,0,14"/>
  <TextBlock Text="备注（可选）" Margin="0,0,0,6"/><TextBox x:Name="NoteText" Height="65" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="500" Margin="0,0,0,12"/>
  <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" MinHeight="28"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Click="Cancel_Click"/><Button Content="保存时间" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="0"/></StackPanel>
 </StackPanel>
</UserControl>
